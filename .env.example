# Copy to .env and chmod 600 .env. Never commit real secrets.
# KEY=value, optional matching quotes, no shell expansion or inline comments.
# Exported variables override this file.
WORKBENCH_NAME=cli-workbench
CLOUD_PROVIDER=hetzner
# v1 implements Codex only; more provider/agent adapters can be added later.
AGENTS=codex
HCLOUD_TOKEN=
# Numeric ID of your public key uploaded to the same Hetzner project.
HCLOUD_SSH_KEY_ID=
SSH_PRIVATE_KEY=~/.ssh/id_ed25519
SSH_SOURCE_CIDR=0.0.0.0/0
HCLOUD_SERVER_TYPE=cpx32
HCLOUD_LOCATION=nbg1
HCLOUD_IMAGE=ubuntu-24.04
WAIT_SECONDS=1200
SWAP_MB=2048

# cloudflare = stable HTTPS/PWA; ssh = local forwarding with no DNS changes.
ACCESS_MODE=cloudflare
PUBLIC_HOSTNAME=agents.example.com
# Named tunnel connector token, not a Cloudflare API key.
CLOUDFLARE_TUNNEL_TOKEN=
# Set true only after protecting the hostname with an Access allow policy.
ACCESS_POLICY_CONFIRMED=false
CLOUDCLI_VERSION=1.37.3
CODEX_VERSION=0.156.1
PNPM_VERSION=10.17.1
# Optional; blank uses device login. API usage has separate billing.
OPENAI_API_KEY=
# Optional; blank uses gh auth login --web in the developer terminal.
GH_TOKEN=

# Private R2/S3 bucket and dedicated prefix; no object-expiration rule.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET/cli-workbench
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
RESTIC_PASSWORD=
# First deployment only: fresh + true. Subsequent deployments: auto + false.
RESTORE_MODE=fresh
RESTIC_INIT=true
# false excludes only Codex auth.json; CloudCLI DB may still contain secrets.
PERSIST_CODEX_AUTH=false
INSTALL_BROWSER=false
PLAYWRIGHT_VERSION=1.55.1
